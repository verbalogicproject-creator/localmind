<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- android:name MUST point at the @HiltAndroidApp class. The annotation on a
         class the system never instantiates produces the identical launch crash as
         having no annotation at all, and looks correct in the source.

         Note: XML comments may not contain a double hyphen. Writing one is a parse
         error, not a style problem, and it is easy to introduce by carrying an
         em-dash habit over from shell or Kotlin. Preflight check 070 catches it. -->
    <application
        android:name=".Localmind"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Localmind"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Localmind">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
