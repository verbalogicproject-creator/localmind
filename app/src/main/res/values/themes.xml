<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theme. This exists only so the manifest has a
         valid android:theme before the first frame; a manifest referencing a style
         that does not exist fails at AAPT with a resource-not-found error. -->
    <style name="Theme.Conformance" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
